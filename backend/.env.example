# ==========================================
# FleetWise Environment Configuration Template
# Copy to .env and configure as appropriate
# ==========================================

# Server & Network Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SQLite Database Persistence
DATABASE_URL="file:./dev.db"

# Initial Account Provisioning (Safe defaults; change in production)
INITIAL_ADMIN_PASSWORD=ChangeMeAdmin@12345
INITIAL_DISPATCHER_PASSWORD=ChangeMeDispatch@12345

# Session & Security
SESSION_EXPIRY_HOURS=24
