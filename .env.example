# ==========================================
# FleetWise Platform — Root Environment Example
# ==========================================

# Backend Express API Service
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SQLite Database Persistence
DATABASE_URL="file:./dev.db"

# Initial Account Provisioning (Change for production)
INITIAL_ADMIN_PASSWORD=ChangeMeAdmin@12345
INITIAL_DISPATCHER_PASSWORD=ChangeMeDispatch@12345

# Frontend Dev Server Proxy
VITE_API_URL=http://localhost:5001
